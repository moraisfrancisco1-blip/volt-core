# VOLT CORE staging configuration
POSTGRES_DB=volt_core_staging
POSTGRES_USER=volt_staging
POSTGRES_PASSWORD=replace_with_a_long_random_password

VOLT_BOOTSTRAP_CLIENT=volt-admin-staging
VOLT_BOOTSTRAP_KEY=replace_with_a_long_random_api_key

# Dedicated least-privilege key for monitored systems that only write events.
VOLT_WATCH_CLIENT=daiane-oakes-admin
VOLT_WATCH_CLIENT_KEY=replace_with_a_dedicated_watch_api_key

VOLT_STAGING_PORT=8000

# Continuous monitoring (optional)
# JSON array of systems with public health endpoints. Must be a real, unprotected public
# URL -- a Vercel preview deployment behind SSO/Deployment Protection will redirect to a
# login page that returns 200, which reads as "healthy" even when the real app is down
# (the Daiane Oakes Admin Panel's first known URL had exactly this problem -- the fixed
# admin.studiodaioakes.com domain below is the real, unprotected production one).
# Live value currently set on the production api service:
# VOLT_MONITOR_TARGETS=[{"system_id":"voltaris-os","system_name":"VoltarisOS Backend","environment":"production","url":"https://voltarisos-production.up.railway.app/health"},{"system_id":"daiane-oakes-admin","system_name":"Daiane Oakes Admin Panel","environment":"production","url":"https://admin.studiodaioakes.com/api/health"}]
VOLT_MONITOR_TARGETS=[]
VOLT_MONITOR_INTERVAL_SECONDS=60
VOLT_MONITOR_TIMEOUT_SECONDS=8
VOLT_MONITOR_FAILURE_THRESHOLD=3

# Voice escalation (optional). VOLT_PUBLIC_BASE_URL must be a publicly reachable HTTPS
# origin so Twilio can POST call-status callbacks back to /api/voice/status -- without it,
# calls still go out but delivery is never confirmed and the SLA loop keeps retrying.
# VOLT_PUBLIC_BASE_URL=https://your-staging-api-domain.example
VOLT_MAX_CALL_ATTEMPTS=3

# Jarvis investigation agent (optional). Fires only when a P1/P2/P3 call fails to be
# confirmed -- read-only, never executes anything. Voice escalation is unaffected either
# way. Without ANTHROPIC_API_KEY, each investigation is still attempted and recorded,
# just as a failed one (see GET /api/investigations) -- not silently skipped.
# ANTHROPIC_API_KEY=replace_with_a_real_anthropic_api_key
VOLT_JARVIS_MODEL=claude-sonnet-4-5
VOLT_JARVIS_MAX_TURNS=6
VOLT_JARVIS_QUEUE_MAXSIZE=50

# Dev/Debug investigation agent (optional). Chains off Jarvis: fires only when the
# Production Monitor investigation above completes with is_known_pattern=false AND the
# affected system has an entry in VOLT_SYSTEM_REPOS. Read-only against GitHub -- never
# writes to, or even clones, the target repo; lists/reads/searches via the REST API only.
# GITHUB_TOKEN should be a fine-grained PAT scoped read-only to exactly the repos listed
# in VOLT_SYSTEM_REPOS -- that scoping is the real enforcement boundary, not app code.
# GITHUB_TOKEN=replace_with_a_fine_grained_read_only_pat
# Example: VOLT_SYSTEM_REPOS={"voltaris-os":"moraisfrancisco1-blip/VoltarisOS","daiane-oakes-admin":"moraisfrancisco1-blip/daianeadminpanel-1688"}
VOLT_SYSTEM_REPOS={}
VOLT_DEVDEBUG_MODEL=claude-sonnet-4-5
VOLT_DEVDEBUG_MAX_TURNS=10
