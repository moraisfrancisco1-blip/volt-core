# VOLT CORE staging configuration
POSTGRES_DB=volt_core_staging
POSTGRES_USER=volt_staging
POSTGRES_PASSWORD=replace_with_a_long_random_password

VOLT_BOOTSTRAP_CLIENT=volt-admin-staging
VOLT_BOOTSTRAP_KEY=replace_with_a_long_random_api_key
VOLT_STAGING_PORT=8000

# Continuous monitoring (optional)
# JSON array of systems with public health endpoints.
# Example:
# VOLT_MONITOR_TARGETS=[{"system_id":"daiane-oakes-admin","system_name":"Daiane Oakes Admin Panel","environment":"production","url":"https://your-admin-domain.vercel.app/api/health"}]
VOLT_MONITOR_TARGETS=[]
VOLT_MONITOR_INTERVAL_SECONDS=60
VOLT_MONITOR_TIMEOUT_SECONDS=8
VOLT_MONITOR_FAILURE_THRESHOLD=3
